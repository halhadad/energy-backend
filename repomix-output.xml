        };
        var rows = await query
            .Where(a => a.OrgId == orgId && a.Timestamp >= start && a.Timestamp < end)
            .OrderBy(a => a.Timestamp)
            .Select(a => new
            {
                a.Timestamp,
                a.TotalActiveEnergyKwh,
                a.AverageActivePowerWatts,
                a.MinActivePowerWatts,
                a.MaxActivePowerWatts,
                a.AverageVoltageVolts,
                a.AverageCurrentAmps,
                a.AveragePowerFactor,
                a.DataPointsCount
            })
            .ToListAsync();
        return rows.Select(r => (
            r.Timestamp,
            (decimal)r.TotalActiveEnergyKwh,
            (double)r.AverageActivePowerWatts,
            (double)r.MinActivePowerWatts,
            (double)r.MaxActivePowerWatts,
            (double)r.AverageVoltageVolts,
            (double)r.AverageCurrentAmps,
            (double)r.AveragePowerFactor,
