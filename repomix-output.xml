    {
        if (!TryGetUserId(out var userId)) return Unauthorized();
        var result = await settingService.GetOrCreateAsync(userId);
        return Ok(result);
    }
    [HttpPatch]
    public async Task<IActionResult> Update([FromBody] UpdateSettingDto dto)
    {
        if (!TryGetUserId(out var userId)) return Unauthorized();
        try
