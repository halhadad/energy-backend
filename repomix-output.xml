using energy_backend.Application.Interfaces;
using energy_backend.Application.Models;
using energy_backend.Core.Enums;
using energy_backend.Core.Interfaces;
using energy_backend.Core.Services;
namespace energy_backend.Application.Services;
public class EnergyAnalyticsOrchestratorService(IAnalyticsRepository metricRepository)
    : IEnergyAnalyticsOrchestratorService
{
    public async Task<OrganisationAnalyticsDto?> GetOrganisationAnalyticsAsync(Guid organisationId)
    {
        var now = DateTime.UtcNow;
        var minuteStart = now.AddMinutes(-30);
        var hourStart = now.AddDays(-1);
        var dayStart = now.AddDays(-7);
        var monthStart = now.AddMonths(-1);
        var minuteTask = metricRepository.GetRawAggregateMetricsAsync(organisationId, minuteStart, now, TimeGranularity.Minute);
        var hourTask = metricRepository.GetRawAggregateMetricsAsync(organisationId, hourStart, now, TimeGranularity.Hour);
        var dayTask = metricRepository.GetRawAggregateMetricsAsync(organisationId, dayStart, now, TimeGranularity.Day);
        var monthTask = metricRepository.GetRawAggregateMetricsAsync(organisationId, monthStart, now, TimeGranularity.Month);
        await Task.WhenAll(minuteTask, hourTask, dayTask, monthTask);
        var costRate = await metricRepository.GetUserCostRateAsync(organisationId);
        return new OrganisationAnalyticsDto
        {
            PeriodStart = monthStart,
            PeriodEnd = now,
            MinuteRollups = (await minuteTask).Select(x => MapToRollupDto(x, costRate, "HH:mm:ss")).ToList(),
            HourRollups = (await hourTask).Select(x => MapToRollupDto(x, costRate, "HH:mm")).ToList(),
            DayRollups = (await dayTask).Select(x => MapToRollupDto(x, costRate, "ddd d")).ToList(),
            MonthRollups = (await monthTask).Select(x => MapToRollupDto(x, costRate, "MMM yy")).ToList()
        };
    }
    private static EnergyMetricRollupDto MapToRollupDto(
        (DateTime Timestamp, decimal TotalEnergy, double AvgWatts, double MinWatts, double MaxWatts,
            double AvgVoltage, double TotalCurrent, double AvgPF, int Count) raw,
        decimal costRate,
        string labelFormat) => new()
    {
        Timestamp = raw.Timestamp,
        Label = raw.Timestamp.ToString(labelFormat),
        TotalEnergyKwh = raw.TotalEnergy,
        AverageActivePowerWatts = raw.AvgWatts,
        MinActivePowerWatts = raw.MinWatts,
        MaxActivePowerWatts = raw.MaxWatts,
        AverageVoltageVolts = raw.AvgVoltage,
        TotalCurrentAmps = raw.TotalCurrent,
        AveragePowerFactor = raw.AvgPF,
        DataPointsCount = raw.Count,
        EstimatedCost = (decimal)EnergyCalculator.CalculateEstimatedCost((float)raw.TotalEnergy, (float)costRate)
    };
}
